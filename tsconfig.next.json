{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next/types/**/*.ts",
    "next.config.mjs",
    "src/app/api/**/*.ts",
    "src/contracts/**/*.ts",
    "src/lib/supabase/**/*.ts",
    "src/server/**/*.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
